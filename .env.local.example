# Copia este archivo como ".env.local" y completa los datos.
# En Vercel, agrega estas mismas variables en Settings → Environment Variables.

# Gmail que envía los correos del Libro de Reclamaciones
GMAIL_USUARIO=tucorreo@gmail.com

# "Contraseña de aplicación" de Google (16 letras). NO es tu contraseña normal.
# Se crea en https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos).
GMAIL_CLAVE_APP=

# Opcional: correo que recibe los reclamos (si se deja vacío, usa correoDestino de lib/config.js)
CORREO_RECLAMOS=
